{
	"name": "SemanticInterlanguageLinks",
	"version": "3.0.0",
	"author": [
		"James Hong Kong",
		"..."
	],
	"url": "https://github.com/SemanticMediaWiki/SemanticInterlanguageLinks/",
	"descriptionmsg": "sil-desc",
	"namemsg": "sil-name",
	"license-name": "GPL-2.0-or-later",
	"type": "semantic",
	"requires": {
		"MediaWiki": ">= 1.43",
		"extensions": {
			"SemanticMediaWiki": ">= 7.0"
		}
	},
	"AutoloadNamespaces": {
		"SIL\\": "src/"
	},
	"TestAutoloadNamespaces": {
		"SIL\\Tests\\": "tests/phpunit/"
	},
	"MessagesDirs": {
		"SemanticInterlanguageLinks": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"SemanticInterlanguageLinksMagic": "i18n/SemanticInterlanguageLinks.magic.php"
	},
	"ServiceWiringFiles": [
		"src/ServiceWiring.php"
	],
	"HookHandlers": {
		"ParserHooks": {
			"class": "SIL\\Hooks\\ParserHooks",
			"services": [
				"SIL.InterlanguageLinksLookup",
				"SIL.PageContentLanguageOnTheFlyModifier"
			]
		},
		"CacheInvalidationHooks": {
			"class": "SIL\\Hooks\\CacheInvalidationHooks",
			"services": [
				"SIL.InterlanguageLinksLookup"
			]
		},
		"PageLanguageHooks": {
			"class": "SIL\\Hooks\\PageLanguageHooks",
			"services": [
				"SIL.InterlanguageLinksLookup",
				"SIL.PageContentLanguageOnTheFlyModifier"
			]
		},
		"PropertyHooks": {
			"class": "SIL\\Hooks\\PropertyHooks"
		},
		"ConfigHooks": {
			"class": "SIL\\Hooks\\ConfigHooks"
		}
	},
	"Hooks": {
		"ParserFirstCallInit": "ParserHooks",
		"ParserAfterTidy": "ParserHooks",
		"ArticlePurge": "CacheInvalidationHooks",
		"RevisionFromEditComplete": "CacheInvalidationHooks",
		"SMW::SQLStore::BeforeDeleteSubjectComplete": "CacheInvalidationHooks",
		"SMW::SQLStore::BeforeChangeTitleComplete": "CacheInvalidationHooks",
		"ArticleFromTitle": "PageLanguageHooks",
		"PageContentLanguage": "PageLanguageHooks",
		"SkinTemplateGetLanguageLink": "PageLanguageHooks",
		"SMW::Property::initProperties": "PropertyHooks",
		"SMW::Settings::BeforeInitializationComplete": "ConfigHooks"
	},
	"config_prefix": "silg",
	"config": {
		"CacheType": {
			"value": -1,
			"description": "Cache used to improve query lookups. Defaults to CACHE_ANYTHING (-1)."
		},
		"EnabledCategoryFilterByLanguage": {
			"value": true,
			"description": "Enable language filtering on the category page."
		}
	},
	"manifest_version": 2
}
