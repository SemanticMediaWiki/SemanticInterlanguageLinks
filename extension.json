{
	"name": "SemanticInterlanguageLinks",
	"version": "3.0.0-alpha",
	"author": [
		"James Hong Kong",
		"..."
	],
	"url": "https://github.com/SemanticMediaWiki/SemanticInterlanguageLinks/",
	"descriptionmsg": "sil-desc",
	"namemsg": "sil-name",
	"license-name": "GPL-2.0-or-later",
	"type": "semantic",
	"requires": {
		"MediaWiki": ">= 1.43",
		"extensions": {
			"SemanticMediaWiki": ">= 7.0"
		}
	},
	"AutoloadNamespaces": {
		"SIL\\": "src/"
	},
	"TestAutoloadNamespaces": {
		"SIL\\Tests\\": "tests/phpunit/"
	},
	"MessagesDirs": {
		"SemanticInterlanguageLinks": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"SemanticInterlanguageLinksMagic": "i18n/SemanticInterlanguageLinks.magic.php"
	},
	"Hooks": {
		"SMW::Settings::BeforeInitializationComplete": "SIL\\HookRegistry::onBeforeConfigCompletion"
	},
	"ExtensionFunctions": [
		"SIL\\Setup::onExtensionFunction"
	],
	"config_prefix": "silg",
	"config": {
		"CacheType": {
			"value": -1,
			"description": "Cache used to improve query lookups. Defaults to CACHE_ANYTHING (-1)."
		},
		"EnabledCategoryFilterByLanguage": {
			"value": true,
			"description": "Enable language filtering on the category page."
		}
	},
	"load_composer_autoloader": true,
	"manifest_version": 2
}
